# Server URL
# - local development: http://localhost:3001
# - deployed: your server's URL
VITE_SERVER_URL=http://localhost:3001

# Admin token for the researcher dashboard (must equal ADMIN_TOKEN in server/.env)
VITE_ADMIN_TOKEN=change-me

# Qualtrics survey URLs.
# The participant code is passed as ?ParticipantCode=. The post-survey also gets
# &Condition=(C1–C4 or CTRL), so the survey can hide the AI questions in CTRL.
VITE_QUALTRICS_CONSENT_URL=https://qualtrics.com/CHANGE_ME_CONSENT
VITE_QUALTRICS_DEMOGRAPHICS_URL=https://qualtrics.com/CHANGE_ME_DEMOGRAPHICS
VITE_QUALTRICS_POSTSURVEY_URL=https://qualtrics.com/CHANGE_ME_POSTSURVEY
